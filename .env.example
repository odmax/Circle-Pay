# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/circle-pay?schema=public"

# NextAuth
AUTH_SECRET="" # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# PayFast (South Africa payments)
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX=true

# Owner Admin
# Case-insensitive comparison. Must be set for owner features.
# Changing OWNER_EMAIL does NOT automatically demote the previous owner.
# The primary owner receives:
#   - InternalAdmin SUPER_ADMIN role on register/login
#   - owner-unlimited plan (hidden from public pricing, unlimited circles)
OWNER_EMAIL="admin@mozetech.com"

# SMTP (password reset emails)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@circlepay.app"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron jobs (contribution scheduler, automations, approval processing)
# Required to authorize the /api/cron/* endpoints. If unset, every cron route
# fails closed (returns 401). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.)
# Proof files are stored here; they are never written to the local filesystem.
# The DB stores a stable internal URL (/api/proofs/...) that is resolved to a
# short-lived presigned GET URL by a protected route at request time.
# For AWS S3 these credentials are also honoured from the AWS_* env vars the
# Vercel/AWS platform injects (region, access key, secret key) automatically.
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
# Optional. Set only for S3-compatible providers (e.g. Cloudflare R2 or MinIO).
AWS_S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# TTL (seconds) for presigned proof GET URLs. Defaults to 3600 if unset.
PROOF_URL_TTL_SECONDS=3600
