// ─── Wallet & Ledger ──────────────────────────────────────
//
// DESIGN RULES:
// 1. LedgerEntry is IMMUTABLE — never UPDATE or DELETE
// 2. LedgerAccount has NO stored balance — always computed from entries
// 3. Reversals = new LedgerTransaction + new LedgerEntries (never edit originals)
// 4. Balance = SUM(CREDIT) - SUM(DEBIT) for each account, computed at read time

enum WalletType {
  USER_WALLET
  CIRCLE_WALLET
  PLATFORM_HOLDING
  PROVIDER_HOLDING
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LedgerAccountType {
  CONTRIBUTIONS
  PAYOUTS
  EXPENSES
  SETTLEMENTS
  FEES
  ADJUSTMENTS
  INVESTMENTS
  RETURNS
  INCOME
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

model Wallet {
  id        String       @id @default(cuid())
  circleId  String?
  userId    String?
  type      WalletType
  status    WalletStatus @default(ACTIVE)
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  circle       Circle?             @relation(fields: [circleId], references: [id])
  user         User?               @relation("WalletUser", fields: [userId], references: [id])
  accounts     LedgerAccount[]
  transactions WalletTransaction[]

  @@index([circleId])
  @@index([userId])
}

// LedgerAccount — NO balance field. Balance is computed from LedgerEntry rows.
model LedgerAccount {
  id        String            @id @default(cuid())
  walletId  String
  name      String
  type      LedgerAccountType
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  wallet  Wallet        @relation(fields: [walletId], references: [id])
  entries LedgerEntry[]

  @@index([walletId])
}

// LedgerTransaction: groups balanced entries. Sum of debits = sum of credits.
model LedgerTransaction {
  id             String   @id @default(cuid())
  circleId       String
  amount         Decimal  @db.Decimal(12, 2)
  type           String // CONTRIBUTION, PAYOUT, EXPENSE, SETTLEMENT, FEE, REVERSAL
  status         String   @default("PENDING") // PENDING, CONFIRMED, REVERSED
  idempotencyKey String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  circle    Circle              @relation(fields: [circleId], references: [id])
  entries   LedgerEntry[]
  walletTxs WalletTransaction[]

  @@index([circleId])
}

// LedgerEntry: IMMUTABLE. Never UPDATE or DELETE. Creates audit trail.
model LedgerEntry {
  id          String          @id @default(cuid())
  accountId   String
  txId        String
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdAt   DateTime        @default(now())

  account     LedgerAccount     @relation(fields: [accountId], references: [id])
  transaction LedgerTransaction @relation(fields: [txId], references: [id])

  @@index([accountId])
  @@index([txId])
}

// WalletTransaction: user-facing record linked to underlying ledger
model WalletTransaction {
  id             String   @id @default(cuid())
  walletId       String
  ledgerTxId     String
  type           String // TOPUP, PAYOUT, WITHDRAWAL, TRANSFER_IN, TRANSFER_OUT
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("PENDING") // PENDING, CONFIRMED, FAILED, CANCELLED
  description    String?
  initiatedById  String
  providerRef    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  wallet           Wallet                  @relation(fields: [walletId], references: [id])
  ledgerTx         LedgerTransaction       @relation(fields: [ledgerTxId], references: [id])
  initiatedBy      User                    @relation("WalletTxInitiator", fields: [initiatedById], references: [id])
  approvalRequests WalletApprovalRequest[]

  @@index([walletId])
  @@index([createdAt])
}

// WalletApprovalRule: defines required approvers for wallet actions
model WalletApprovalRule {
  id                    String   @id @default(cuid())
  circleId              String
  action                String // WITHDRAWAL, PAYOUT, EXPENSE_OVER
  threshold             Decimal  @db.Decimal(12, 2)
  requiredApprovalCount Int      @default(1)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id])

  @@index([circleId])
}

model WalletApprovalRequest {
  id            String   @id @default(cuid())
  circleId      String
  walletTxId    String
  requestedById String
  requiredCount Int      @default(1)
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  circle      Circle            @relation(fields: [circleId], references: [id])
  walletTx    WalletTransaction @relation(fields: [walletTxId], references: [id])
  requestedBy User              @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvals   WalletApproval[]

  @@index([circleId])
}

model WalletApproval {
  id           String   @id @default(cuid())
  requestId    String
  approvedById String
  approvedAt   DateTime @default(now())

  request    WalletApprovalRequest @relation(fields: [requestId], references: [id])
  approvedBy User                  @relation("ApprovalApprover", fields: [approvedById], references: [id])
}

// ─── Payout Cycles (Stokvel Rotation) ───────────────────

enum PayoutCycleStatus {
  UPCOMING
  READY
  BLOCKED
  PENDING_APPROVAL
  APPROVED
  PAID
  CONFIRMED_RECEIVED
  COMPLETED
  SKIPPED
  DEFERRED
  CANCELLED
}

enum PayoutMode {
  FIXED_ORDER
  MANUAL_ORDER
  RANDOM_DRAW
}

enum PayoutFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

model PayoutConfig {
  id                             String          @id @default(cuid())
  circleId                       String          @unique
  mode                           PayoutMode      @default(FIXED_ORDER)
  frequency                      PayoutFrequency @default(MONTHLY)
  amount                         Decimal?        @db.Decimal(12, 2)
  useCollectedPot                Boolean         @default(false)
  startDate                      DateTime?
  graceDays                      Int             @default(0)
  requireConfirmedContributions  Boolean         @default(true)
  minimumApprovals               Int             @default(1)
  requireBeneficiaryConfirmation Boolean         @default(true)
  allowSwap                      Boolean         @default(false)
  isActive                       Boolean         @default(true)
  createdById                    String
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  circle    Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User          @relation("PayoutConfigCreator", fields: [createdById], references: [id])
  cycles    PayoutCycle[]

  @@index([circleId])
}

model PayoutCycle {
  id                 String            @id @default(cuid())
  circleId           String
  cycleNumber        Int
  recipientId        String
  amount             Decimal           @db.Decimal(12, 2)
  dueDate            DateTime?
  status             PayoutCycleStatus @default(UPCOMING)
  completionStatus   String? // PAID / PARTIAL / UNPAID contribution completion of the recipient for the period
  readiness          String? // summary of readiness state, e.g. "READY" or block reason
  readiedAt          DateTime?
  approvedAt         DateTime?
  paidAt             DateTime?
  confirmedAt        DateTime?
  paymentMethod      String?
  reference          String?
  proofUrl           String?
  proofReference     String?
  proofUploadedById  String?
  notes              String?
  skipReason         String?
  deferReason        String?
  deferToCycleNumber Int?
  drawAt             DateTime?
  drawEligibleIds    Json? // snapshot of eligible member ids for RANDOM_DRAW
  orderedBy          String? // actor who assigned the recipient (MANUAL_ORDER)
  approvalRequestId  String?           @unique
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  circle    Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  recipient User           @relation("PayoutRecipient", fields: [recipientId], references: [id])
  config    PayoutConfig?  @relation(fields: [configId], references: [id])
  configId  String?
  payment   PayoutPayment?
  events    PayoutEvent[]

  @@unique([circleId, cycleNumber])
  @@index([circleId])
  @@index([recipientId])
  @@index([status])
}

model PayoutPayment {
  id                  String    @id @default(cuid())
  cycleId             String    @unique
  circleId            String
  recipientId         String
  amount              Decimal   @db.Decimal(12, 2)
  paidDate            DateTime?
  method              String?
  reference           String?
  proofUrl            String?
  proofReference      String?
  notes               String?
  paidById            String
  confirmedById       String?
  confirmedAt         DateTime?
  issueReported       Boolean   @default(false)
  issueDescription    String?
  ledgerTransactionId String?
  idempotencyKey      String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  circle    Circle      @relation(fields: [circleId], references: [id], onDelete: Cascade)
  recipient User        @relation("PayoutPaymentRecipient", fields: [recipientId], references: [id])
  paidBy    User        @relation("PayoutPaymentPaidBy", fields: [paidById], references: [id])
  cycle     PayoutCycle @relation(fields: [cycleId], references: [id])

  @@index([circleId])
  @@index([recipientId])
}

model PayoutEvent {
  id          String   @id @default(cuid())
  circleId    String
  cycleId     String?
  type        String // QUEUE_CREATED, READY, APPROVED, BLOCKED, PAID, CONFIRMED, SKIPPED, DEFERRED, SWAPPED, DRAW, ISSUE
  actorId     String?
  recipientId String?
  amount      Decimal? @db.Decimal(12, 2)
  note        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  circle    Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  cycle     PayoutCycle? @relation(fields: [cycleId], references: [id])
  actor     User?        @relation("PayoutEventActor", fields: [actorId], references: [id])
  recipient User?        @relation("PayoutEventRecipient", fields: [recipientId], references: [id])

  @@index([circleId])
  @@index([cycleId])
}

// ─── Community Feed ──────────────────────────────────────

enum FeedPostType {
  ANNOUNCEMENT
  UPDATE
