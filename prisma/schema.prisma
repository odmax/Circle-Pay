enum ProjectOwnershipProposalStatus {
  PROPOSED
  APPROVED
  REJECTED
  EFFECTIVE
  SUPERSEDED
}

model ProjectOwnershipSnapshot {
  id             String                         @id @default(cuid())
  projectId      String
  version        Int
  totalCapital   Decimal                        @db.Decimal(12, 2)
  status         ProjectOwnershipProposalStatus @default(PROPOSED)
  proposalNote   String?
  approvedById   String?
  approvedAt     DateTime?
  effectiveDate  DateTime?
  supersededAt   DateTime?
