// ─── Multi-Stage Approval Workflows (Phase 4) ─────────
//
// Configurable multi-stage approval workflows that snapshot into
// immutable runtime models at request creation time.
//
// Workflow configuration lives in ApprovalWorkflow + stages/reviewers.
// Runtime snapshots live in ApprovalRequestStage + reviewers/decisions.
// Once a request is created, the workflow config is NEVER re-read.

enum ApprovalWorkflowStatus {
  DRAFT // Not yet activated; can be freely edited
  ACTIVE // Live — used to resolve new requests
  INACTIVE // Temporarily disabled; existing requests continue
  ARCHIVED // Permanently retired; cannot be reactivated
}

enum ApprovalStageMode {
  SEQUENTIAL // Reviewers act one after another; stages advance in order
  PARALLEL // All reviewers act simultaneously within a stage
}

/// Runtime status of a stage on an ApprovalRequest.
/// Named `ApprovalStageStatus` in the spec; called
/// `ApprovalStageRuntimeStatus` here to avoid collision with the
/// workflow-level configuration enums.
enum ApprovalStageRuntimeStatus {
  WAITING // Not yet reached (earlier stages still in progress)
  ACTIVE // Currently accepting decisions
  APPROVED // Stage met its approval threshold
  REJECTED // Stage met its rejection threshold
  SKIPPED // Stage was skipped (e.g. amount below threshold)
  EXPIRED // Stage expired before completion
  CANCELLED // Parent request was cancelled
}

enum ApprovalReviewerType {
  ROLE // Resolve reviewer(s) by circle role (OWNER, ADMIN, …)
  MEMBER // Specific circle member by userId
  PERMISSION // Resolve reviewer(s) by a circle permission
}

enum ApprovalEscalationAction {
  NOTIFY // Send a notification to the escalation target
  REASSIGN // Move the review to a different reviewer
  ADD_REVIEWER // Add an additional reviewer to the stage
  ESCALATE_TO_OWNER // Escalate to the circle owner
  AUTO_REJECT // Automatically reject if escalation target doesn't act
}

enum ApprovalDelegationStatus {
  ACTIVE // Delegation is in effect (within startsAt..endsAt window)
  REVOKED // Manually revoked by the delegator or an admin
  EXPIRED // Automatically expired by the cron processor
}

// ─── ApprovalWorkflow ─────────────────────────────────
//
// Defines a reusable, versioned approval process for a circle + approvalType.
// Only ONE workflow may be marked isDefault per circle + type.
// Only one workflow should be ACTIVE at a time per circle + type (enforced in service).
// Workflows are resolved by: type match → amount range → priority → createdAt.

model ApprovalWorkflow {
  id            String                 @id @default(cuid())
  circleId      String
  type          ApprovalType
  name          String
  description   String?
  status        ApprovalWorkflowStatus @default(DRAFT)
  priority      Int                    @default(0)
  minimumAmount Decimal?               @db.Decimal(12, 2)
  maximumAmount Decimal?               @db.Decimal(12, 2)
  currency      String?
  isDefault     Boolean                @default(false)
  version       Int                    @default(1)
  createdById   String
  updatedById   String?
  archivedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  circle    Circle                  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User                    @relation("WorkflowCreator", fields: [createdById], references: [id])
  updatedBy User?                   @relation("WorkflowUpdater", fields: [updatedById], references: [id])
  stages    ApprovalWorkflowStage[]

  @@index([circleId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([isDefault])
  @@index([circleId, type])
}

// ─── ApprovalWorkflowStage ────────────────────────────
//
// A single stage within a workflow. Stages are ordered (1, 2, …) and
// executed according to the workflow's mode (sequential or parallel).
// Deleting a workflow cascades to its stages.

model ApprovalWorkflowStage {
  id                   String            @id @default(cuid())
  workflowId           String
  name                 String
  description          String?
  order                Int
  mode                 ApprovalStageMode @default(SEQUENTIAL)
  minimumApprovals     Int               @default(1)
  rejectionThreshold   Int? // Number of rejections that kill the stage (null = any single reject)
  requireAllReviewers  Boolean           @default(false)
  allowSelfApproval    Boolean           @default(false)
  ownerRequired        Boolean           @default(false)
  expiresAfterHours    Int? // Hours after activation before the stage expires
  escalationAfterHours Int? // Hours after activation before escalation triggers
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workflow  ApprovalWorkflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reviewers ApprovalWorkflowStageReviewer[]

  @@unique([workflowId, order])
  @@index([workflowId])
}

// ─── ApprovalWorkflowStageReviewer ────────────────────
//
// Defines who reviews at a given workflow stage.
// reviewerType determines how memberId / role / permission are used:
//   ROLE       → role column holds the MemberRole string
//   MEMBER     → memberId holds the target userId
//   PERMISSION → permission column holds a CirclePermission string
// This is the CONFIGURATION model; runtime snapshots use
// ApprovalRequestStageReviewer.

model ApprovalWorkflowStageReviewer {
  id           String               @id @default(cuid())
  stageId      String
  reviewerType ApprovalReviewerType
  role         String?
  memberId     String?
  permission   String?
  required     Boolean              @default(false)
  createdAt    DateTime             @default(now())

  stage ApprovalWorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@index([memberId])
}

// ─── ApprovalRequestStage (Runtime Snapshot) ──────────
//
// Immutable snapshot of a workflow stage at the time a request is created.
// Once created, the workflow configuration is NEVER re-read for this request.
// Status transitions: WAITING → ACTIVE → APPROVED/REJECTED/EXPIRED/CANCELLED
//                     WAITING → SKIPPED (if amount below threshold, etc.)
//
// Lifecycle:
//   1. Created for each stage when request is submitted
//   2. First stage set to ACTIVE; rest remain WAITING
//   3. On stage APPROVED → next WAITING stage becomes ACTIVE
//   4. On stage REJECTED/EXPIRED → entire request is terminated
//   5. On final stage APPROVED → request becomes APPROVED

model ApprovalRequestStage {
  id                  String                     @id @default(cuid())
  approvalRequestId   String
  workflowStageId     String?
  name                String
  order               Int
  mode                ApprovalStageMode          @default(SEQUENTIAL)
  status              ApprovalStageRuntimeStatus @default(WAITING)
  minimumApprovals    Int                        @default(1)
  rejectionThreshold  Int?
  requireAllReviewers Boolean                    @default(false)
  allowSelfApproval   Boolean                    @default(false)
  ownerRequired       Boolean                    @default(false)
  expiresAt           DateTime?
  activatedAt         DateTime?
  completedAt         DateTime?
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  approvalRequest ApprovalRequest                @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  reviewers       ApprovalRequestStageReviewer[]
  decisions       ApprovalRequestDecision[]

  @@index([approvalRequestId])
  @@index([status])
  @@index([order])
}

// ─── ApprovalRequestStageReviewer (Runtime Snapshot) ──
//
// Immutable snapshot of the resolved reviewer set for a runtime stage.
// At creation time, reviewerType + role/memberId/permission from the
// workflow config are resolved to concrete memberIds.
// delegatedFromMemberId tracks delegation chains for audit.

model ApprovalRequestStageReviewer {
  id                    String    @id @default(cuid())
  requestStageId        String
  memberId              String
  required              Boolean   @default(false)
  delegatedFromMemberId String?
  notifiedAt            DateTime?
  actedAt               DateTime?
  createdAt             DateTime  @default(now())

  requestStage ApprovalRequestStage @relation(fields: [requestStageId], references: [id], onDelete: Cascade)

  @@index([requestStageId])
  @@index([memberId])
}

// ─── ApprovalDelegation ───────────────────────────────
//
// Allows a member to delegate their approval authority to another member
// for a specific time window and scope (circle-wide, per type, per workflow,
// or per stage). Cycle detection is enforced in the service layer.
//
// Lifecycle: ACTIVE → REVOKED (manual) or EXPIRED (cron processor)

model ApprovalDelegation {
  id                String                   @id @default(cuid())
  circleId          String
  delegatorMemberId String
  delegateMemberId  String
  approvalType      ApprovalType?
  workflowId        String?
  stageId           String?
  startsAt          DateTime                 @default(now())
  endsAt            DateTime
  status            ApprovalDelegationStatus @default(ACTIVE)
  reason            String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId])
  @@index([delegatorMemberId])
  @@index([delegateMemberId])
  @@index([status])
}

// ─── Project Capital Structure ──────────────────────────────
//
// Phase A: Participant tracking, funding rounds, allocations,
// commitments, capital transactions, and shortfall engine.

enum ProjectParticipantType {
  CIRCLE_MEMBER
  EXTERNAL_INVESTOR
  DONOR
  LENDER
  SPONSOR
  PARTNER
}

enum ProjectParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum ProjectFundingAllocationMethod {
  EQUAL
  PERCENTAGE
  CUSTOM
  OPEN
  HYBRID
}

enum ProjectOverfundingTreatment {
  EXTRA_EQUITY
  REPAYABLE_ADVANCE
  SHORTFALL_COVER
  DONATION
  REQUIRE_SELECTION
}

enum ProjectAllocationStatus {
  PENDING
  COMMITTED
  PARTIALLY_PAID
  PAID
  SHORTFALL
  COVERED
  WAIVED
  CANCELLED
}

model ProjectParticipant {
  id                   String                   @id @default(cuid())
  projectId            String
  circleMemberId       String? // nullable for external participants
  userId               String? // nullable for external participants
  externalName         String? // required if no userId
  externalEmail        String?
  externalPhone        String?
  type                 ProjectParticipantType   @default(CIRCLE_MEMBER)
  status               ProjectParticipantStatus @default(INVITED)
  votingEligible       Boolean                  @default(false)
  distributionEligible Boolean                  @default(true)
  joinedAt             DateTime?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  project                 Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                    User?                       @relation("ProjectParticipantUser", fields: [userId], references: [id])
  allocations             ProjectFundingAllocation[]
  commitments             ProjectFundingCommitment[]
  capitalTransactions     ProjectCapitalTransaction[]
  investorAgreements      ProjectInvestorAgreement[]
  ownershipEntries        ProjectOwnershipEntry[]
  shortfallCoversGiven    ShortfallCover[]            @relation("ShortfallCoverGiver")
  shortfallCoversReceived ShortfallCover[]            @relation("ShortfallCoverReceiver")

  @@index([projectId])
  @@index([userId])
  @@index([circleMemberId])
}

model ProjectFundingAllocation {
  id               String                  @id @default(cuid())
  fundingRoundId   String
  projectId        String
  participantId    String
  allocatedAmount  Decimal                 @db.Decimal(12, 2)
  committedAmount  Decimal                 @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  shortfallAmount  Decimal                 @default(0) @db.Decimal(12, 2)
  excessAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  dueDate          DateTime?
  status           ProjectAllocationStatus @default(PENDING)
  generatedBy      String? // 'SYSTEM' or userId for manual
  adjustedBy       String?
  adjustmentReason String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  fundingRound        ProjectFundingRound         @relation(fields: [fundingRoundId], references: [id], onDelete: Cascade)
  project             Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participant         ProjectParticipant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  capitalTransactions ProjectCapitalTransaction[]
  shortfallCovers     ShortfallCover[]

  @@unique([fundingRoundId, participantId])
  @@index([fundingRoundId])
  @@index([projectId])
  @@index([participantId])
}

enum ProjectCommitmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ProjectFundingClassification {
  REQUIRED_EQUITY
  EXTRA_EQUITY
  SHORTFALL_COVER_EQUITY
  MEMBER_ADVANCE
  EXTERNAL_INVESTMENT
  LOAN
  DONATION
  SPONSORSHIP
}

model ProjectFundingCommitment {
  id                 String                       @id @default(cuid())
  fundingRoundId     String
  projectId          String
  participantId      String
  amount             Decimal                      @db.Decimal(12, 2)
  commitmentDate     DateTime                     @default(now())
  dueDate            DateTime?
  classification     ProjectFundingClassification @default(REQUIRED_EQUITY)
  expectedReturn     Decimal?                     @db.Decimal(12, 2)
  repaymentTerms     String?
  ownershipImpact    Boolean                      @default(false)
  approvalStatus     String                       @default("PENDING") // PENDING, APPROVED, REJECTED
  approvalRequestId  String?
  cancellationReason String?
  status             ProjectCommitmentStatus      @default(PENDING)
  metadata           Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  fundingRound        ProjectFundingRound         @relation(fields: [fundingRoundId], references: [id], onDelete: Cascade)
  project             Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participant         ProjectParticipant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  capitalTransactions ProjectCapitalTransaction[]

  @@index([fundingRoundId])
  @@index([projectId])
  @@index([participantId])
}

enum ProjectCapitalTxStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ProjectCapitalTxClassification {
  REQUIRED_EQUITY
  EXTRA_EQUITY
  SHORTFALL_COVER_EQUITY
  MEMBER_ADVANCE
  EXTERNAL_INVESTMENT
  LOAN
  DONATION
  SPONSORSHIP
}

model ProjectCapitalTransaction {
  id                      String                         @id @default(cuid())
  projectId               String
  fundingRoundId          String?
  allocationId            String?
  commitmentId            String?
  participantId           String
  amount                  Decimal                        @db.Decimal(12, 2)
  transactionDate         DateTime                       @default(now())
  reference               String?
  proofUrl                String?
  classification          ProjectCapitalTxClassification @default(REQUIRED_EQUITY)
  ownershipEligibleAmount Decimal                        @default(0) @db.Decimal(12, 2)
  repaymentEligibleAmount Decimal                        @default(0) @db.Decimal(12, 2)
  profitEligibleAmount    Decimal                        @default(0) @db.Decimal(12, 2)
  status                  ProjectCapitalTxStatus         @default(PENDING)
  confirmedById           String?
  confirmedAt             DateTime?
  rejectedById            String?
  rejectedAt              DateTime?
  rejectionReason         String?
  ledgerEntryId           String?
  receiptId               String?
  metadata                Json?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fundingRound ProjectFundingRound?      @relation(fields: [fundingRoundId], references: [id], onDelete: SetNull)
  allocation   ProjectFundingAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  commitment   ProjectFundingCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  participant  ProjectParticipant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  confirmedBy  User?                     @relation("CapitalTxConfirmer", fields: [confirmedById], references: [id])
  rejectedBy   User?                     @relation("CapitalTxRejector", fields: [rejectedById], references: [id])

  @@index([projectId])
  @@index([fundingRoundId])
  @@index([participantId])
  @@index([status])
}

enum ShortfallCoverType {
  COVER_ADVANCE
  OWNERSHIP_TRANSFER
  PROJECT_ADVANCE
  DONATION
}

enum ShortfallCoverStatus {
  PENDING
  CONFIRMED
  REJECTED
  SETTLED
  CANCELLED
}

model ShortfallCover {
  id                    String               @id @default(cuid())
  projectId             String
  allocationId          String
  coveringParticipantId String // who is covering
  coveredParticipantId  String? // whose shortfall (null = general)
  amount                Decimal              @db.Decimal(12, 2)
  type                  ShortfallCoverType   @default(COVER_ADVANCE)
  repaymentDueDate      DateTime?
  interestRate          Decimal?             @db.Decimal(5, 4) // e.g. 0.0500 = 5%
  ownershipTransferRule String? // description of ownership effect
  status                ShortfallCoverStatus @default(PENDING)
  approvedById          String?
  approvedAt            DateTime?
  settledAt             DateTime?
  metadata              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocation          ProjectFundingAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  coveringParticipant ProjectParticipant       @relation("ShortfallCoverGiver", fields: [coveringParticipantId], references: [id], onDelete: Cascade)
  coveredParticipant  ProjectParticipant?      @relation("ShortfallCoverReceiver", fields: [coveredParticipantId], references: [id], onDelete: SetNull)
  approvedBy          User?                    @relation("ShortfallCoverApprover", fields: [approvedById], references: [id])

  @@index([projectId])
  @@index([allocationId])
  @@index([coveringParticipantId])
  @@index([coveredParticipantId])
}

// ─── Phase B: Investor Agreements & Ownership Register ──────

enum ProjectAgreementType {
  EQUITY
  PROFIT_SHARE
  REVENUE_SHARE
  FIXED_RETURN
  LOAN
  CAPPED_RETURN
  DONATION
}

enum ProjectAgreementStatus {
