generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Models ───────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  phone            String?   @unique
  passwordHash     String?
  currency         String    @default("NGN")
  isSuspended      Boolean   @default(false)
  suspendedAt      DateTime?
  suspendedById    String?
  suspensionReason String?
  settings         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  circlesCreated               Circle[]                     @relation("CircleCreator")
  accounts                     Account[]
  sessions                     Session[]
  circleMembers                CircleMember[]
  contributions                Contribution[]               @relation("ContributionPayer")
  contributionsRecorded        Contribution[]               @relation("ContributionRecorder")
  contributionPlansCreated     ContributionPlan[]           @relation("ContributionPlanCreator")
  contributionSchedulesCreated ContributionSchedule[]       @relation("ContributionScheduleCreator")
  expensesPaid                 Expense[]                    @relation("ExpensePayer")
  expensesCreated              Expense[]                    @relation("ExpenseCreator")
  expenseSplits                ExpenseSplit[]
  notifications                Notification[]
  invitationsSent              Invitation[]                 @relation("Inviter")
  balancesAsDebtor             Balance[]                    @relation("Debtor")
  balancesAsCreditor           Balance[]                    @relation("Creditor")
  settlementsAsDebtor          Settlement[]                 @relation("SettlementDebtor")
  settlementsAsCreditor        Settlement[]                 @relation("SettlementCreditor")
  settlementsCreated           Settlement[]                 @relation("SettlementCreator")
  settlementsConfirmed         Settlement[]                 @relation("SettlementConfirmer")
  goalsCreated                 Goal[]
  goalAllocationsReceived      GoalAllocation[]             @relation("GoalAllocationReceiver")
  goalAllocationsCreated       GoalAllocation[]             @relation("GoalAllocationCreator")
  transactions                 Transaction[]
  subscription                 UserSubscription?
  paymentTransactions          PaymentTransaction[]
  internalAdmin                InternalAdmin?
  auditLogs                    AuditLog[]
  auditLogsAffected            AuditLog[]                   @relation("AuditLogAffectedUser")
  joinRequests                 JoinRequest[]                @relation("JoinRequestUser")
  joinRequestsReviewed         JoinRequest[]                @relation("JoinRequestReviewer")
  wallets                      Wallet[]                     @relation("WalletUser")
  walletTransactions           WalletTransaction[]          @relation("WalletTxInitiator")
  approvalRequests             WalletApprovalRequest[]      @relation("ApprovalRequester")
  approvalsGiven               WalletApproval[]             @relation("ApprovalApprover")
  payoutCycles                 PayoutCycle[]                @relation("PayoutRecipient")
  payoutConfigsCreated         PayoutConfig[]               @relation("PayoutConfigCreator")
  payoutPaymentsReceived       PayoutPayment[]              @relation("PayoutPaymentRecipient")
  payoutPaymentsMade           PayoutPayment[]              @relation("PayoutPaymentPaidBy")
  payoutEventsActed            PayoutEvent[]                @relation("PayoutEventActor")
  payoutEventsReceived         PayoutEvent[]                @relation("PayoutEventRecipient")
  ownerNotes                   OwnerNote[]                  @relation("OwnerNoteAdmin")
  moderationReviews            CircleModerationReview[]     @relation("ModerationReviewer")
  bulkOperations               BulkOperation[]              @relation("BulkOpAdmin")
  platformSettingsUpdated      PlatformSetting[]            @relation("PlatformSettingUpdater")
  featureFlagsUpdated          FeatureFlag[]                @relation("FeatureFlagUpdater")
  promoCodesCreated            PromoCode[]                  @relation("PromoCreator")
  promoRedemptions             PromoRedemption[]            @relation("PromoUser")
  broadcastsCreated            PlatformBroadcast[]          @relation("BroadcastCreator")
  broadcastReceived            PlatformBroadcastRecipient[] @relation("BroadcastRecipient")
  supportTickets               SupportTicket[]              @relation("TicketCreator")
  supportMessages              SupportTicketMessage[]       @relation("TicketMessageSender")
  abuseReports                 AbuseReport[]                @relation("AbuseReporter")
  abuseReportsReviewed         AbuseReport[]                @relation("AbuseReviewer")
  feedPosts                    FeedPost[]                   @relation("FeedPostAuthor")
  feedComments                 FeedComment[]                @relation("FeedCommentUser")
  feedReactions                FeedReaction[]               @relation("FeedReactionUser")
  eventsCreated                CircleEvent[]                @relation("EventCreator")
  eventRSVPs                   CircleEventRSVP[]            @relation("RSVPUser")
  pollsCreated                 CirclePoll[]                 @relation("PollCreator")
  pollVotes                    CirclePollVote[]             @relation("PollVoter")
  passwordResetTokens          PasswordResetToken[]
  verificationsReviewed        CircleVerification[]         @relation("VerificationReviewer")
  completedWorkflowSteps       CircleWorkflowStep[]         @relation("WorkflowStepCompleter")
  paymentIntents               CirclePaymentIntent[]        @relation("PaymentIntentUser")
  paymentIntentsConfirmed      CirclePaymentIntent[]        @relation("PaymentIntentConfirmer")
  projectsCreated              Project[]                    @relation("ProjectCreator")
  fundingRoundsCreated         ProjectFundingRound[]        @relation("FundingRoundCreator")
  projectContributions         ProjectContribution[]        @relation("ProjectContributor")
  projectContConfirmations     ProjectContribution[]        @relation("ProjectContributionConfirmer")
  projectExpensesCreated       ProjectExpense[]             @relation("ProjectExpenseCreator")
  projectExpensesApproved      ProjectExpense[]             @relation("ProjectExpenseApprover")
  projectExpensesPaid          ProjectExpense[]             @relation("ProjectExpensePayer")
  projectExpensesVoided        ProjectExpense[]             @relation("ProjectExpenseVoidedBy")
  projectAssetsCreated         ProjectAsset[]               @relation("ProjectAssetCreator")
  projectRevenuesCreated       ProjectRevenue[]             @relation("ProjectRevenueCreator")
  distributionsCreated         ProjectDistribution[]        @relation("DistributionCreator")
  distributionsApproved        ProjectDistribution[]        @relation("DistributionApprover")
  distributionItems            ProjectDistributionItem[]    @relation("DistributionRecipient")
  projectParticipants          ProjectParticipant[]         @relation("ProjectParticipantUser")
  capitalTxConfirmations       ProjectCapitalTransaction[]  @relation("CapitalTxConfirmer")
  capitalTxRejections          ProjectCapitalTransaction[]  @relation("CapitalTxRejector")
  shortfallCoversApproved      ShortfallCover[]             @relation("ShortfallCoverApprover")
  agreementsApproved           ProjectInvestorAgreement[]   @relation("AgreementApprover")
  ownershipSnapshotsApproved   ProjectOwnershipSnapshot[]   @relation("OwnershipSnapshotApprover")
  revenueApprovals             ProjectRevenue[]             @relation("ProjectRevenueApprover")
  financialStatementsCreated   ProjectFinancialStatement[]  @relation("FinancialStatementCreator")
  financialStatementsApproved  ProjectFinancialStatement[]  @relation("FinancialStatementApprover")
  distributionPeriodsCreated   ProjectDistributionPeriod[]  @relation("DistributionPeriodCreator")
  legalAcceptances             UserLegalAcceptance[]
  constitutionAcceptances      ConstitutionAcceptance[]
  constitutionAmendments       ConstitutionAmendment[]
  constitutionsCreated         Constitution[]              @relation("ConstitutionCreator")
  constitutionVersionsCreated  ConstitutionVersion[]       @relation("ConstitutionVersionCreator")
  constitutionConflictsResolved ConstitutionRuleConflict[] @relation("ConflictResolver")
  mobileSessions               MobileSession[]
  mobilePushTokens             MobilePushToken[]
  univApprovalRequests         ApprovalRequest[]            @relation("UnivApprovalRequester")
  univApprovalDecisions        ApprovalRequestDecision[]    @relation("UnivApprovalReviewer")
  receiptsIssuedTo             FinancialReceipt[]           @relation("ReceiptIssuedTo")
  receiptsIssuedBy             FinancialReceipt[]           @relation("ReceiptIssuedBy")
  receiptsVoidedBy             FinancialReceipt[]           @relation("ReceiptVoidedBy")
  workflowsCreated             ApprovalWorkflow[]           @relation("WorkflowCreator")
  workflowsUpdated             ApprovalWorkflow[]           @relation("WorkflowUpdater")
  meetingsCreated              Meeting[]                    @relation("MeetingCreator")
  meetingRSVPs                 MeetingRSVP[]                @relation("MeetingRSVPUser")
  meetingAttendance            MeetingAttendance[]          @relation("AttendanceMember")
  meetingAttendanceRecorded    MeetingAttendance[]          @relation("AttendanceRecorder")
  agendaItemsCreated           MeetingAgendaItem[]          @relation("AgendaItemCreator")
  actionItemsCreated           MeetingActionItem[]          @relation("ActionItemCreator")
  actionItemsAssigned          MeetingActionItem[]          @relation("ActionItemAssignee")
  meetingMinutesCreated        MeetingMinutes[]             @relation("MinutesCreator")
  meetingMinutesEdited         MeetingMinutesVersion[]      @relation("MinutesVersionEditor")
  governanceVotesCreated       GovernanceVote[]             @relation("VoteCreator")
  governanceVoteOptionsCreated GovernanceVoteOption[]       @relation("VoteOptionCreator")
  governanceVotesCast          GovernanceVoteRecord[]       @relation("VoteCaster")
  governanceBallots            GovernanceBallot[]           @relation("VoteBallot")
  governanceDecisionsCreated   GovernanceDecision[]         @relation("DecisionCreator")
  minutesAcknowledgements      MeetingMinutesAcknowledgement[] @relation("MinutesAcknowledgeUser")

  @@index([email])
}

// ─── Mobile Sessions ──────────────────────────────────────

model MobileSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  deviceId   String?
  platform   String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @unique
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ─── Core Models ───────────────────────────────────────────

enum CircleType {
  FAMILY
  TRAVEL
  HOUSEMATE
  WEDDING
  SAVINGS
  STOKVEL
  CHURCH
  INVESTMENT
  CUSTOM
}

enum CircleVisibility {
  PRIVATE
  INVITE_ONLY
  PUBLIC
}

enum MemberRole {
  OWNER
  ADMIN
  TREASURER
  MEMBER
  VIEWER
}

model Circle {
  id                   String           @id @default(cuid())
  name                 String
  description          String?
  currency             String           @default("NGN")
  type                 CircleType       @default(CUSTOM)
  visibility           CircleVisibility @default(PRIVATE)
  inviteCode           String           @unique @default(cuid())
  inviteCodeEnabled    Boolean          @default(true)
  inviteCodeExpiresAt  DateTime?
  isActive             Boolean          @default(true)
  deletedAt            DateTime?
  country              String?
  city                 String?
  publicDescription    String?
  rules                String?
  joinApprovalRequired Boolean          @default(true)
  isFeatured           Boolean          @default(false)
  featuredAt           DateTime?
  featuredById         String?
  settings             Json?
  createdById          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  createdBy              User                        @relation("CircleCreator", fields: [createdById], references: [id])
  members                CircleMember[]
  contributions          Contribution[]
  contributionPlans      ContributionPlan[]
  contributionSchedules  ContributionSchedule[]
  goals                  Goal[]
  goalAllocations        GoalAllocation[]
  expenses               Expense[]
  balances               Balance[]
  settlements            Settlement[]
  transactions           Transaction[]
  notifications          Notification[]
  invitations            Invitation[]
  auditLogs              AuditLog[]                  @relation("AuditLogCircle")
  aiInsights             AIInsight[]                 @relation("AIInsightCircle")
  automationLogs         CircleAutomationLog[]
  widgets                CircleWidget[]
  expenseCategories      ExpenseCategory[]
  joinRequests           JoinRequest[]
  wallets                Wallet[]
  ledgerTransactions     LedgerTransaction[]
  approvalRules          WalletApprovalRule[]
  approvalRequests       WalletApprovalRequest[]
  circleApprovalRequests ApprovalRequest[]
  financialReceipts      FinancialReceipt[]
  approvalWorkflows      ApprovalWorkflow[]
  approvalDelegations    ApprovalDelegation[]
  payoutCycles           PayoutCycle[]
  payoutConfig           PayoutConfig?
  payoutPayments         PayoutPayment[]
  payoutEvents           PayoutEvent[]
  moderationReviews      CircleModerationReview[]
  supportTickets         SupportTicket[]
  feedPosts              FeedPost[]
  events                 CircleEvent[]
  polls                  CirclePoll[]
  verification           CircleVerification?
  reputation             CircleReputation?
  healthScore            CircleHealthScore?
  inviteEvents           CircleInviteEvent[]
  investmentAssets       InvestmentAsset[]
  investmentReturns      InvestmentReturn[]
  workflow               CircleWorkflow?
  automationRules        CircleAutomationRule[]
  paymentIntents         CirclePaymentIntent[]
  projects               Project[]
  projectExpenses        ProjectExpense[]
  projectAssets          ProjectAsset[]
  projectVendors         ProjectVendor[]
  projectRevenues        ProjectRevenue[]
  distributions          ProjectDistribution[]
  financialStatements    ProjectFinancialStatement[]
  distributionPeriods    ProjectDistributionPeriod[]
  constitution           Constitution?
  constitutionAmendments ConstitutionAmendment[]
  constitutionConflicts  ConstitutionRuleConflict[]
  meetings               Meeting[]
  governanceVotes        GovernanceVote[]
  governanceDecisions    GovernanceDecision[]
}

model CircleMember {
  id       String     @id @default(cuid())
  circleId String
  userId   String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  permissions CircleMemberPermission[]

  @@unique([circleId, userId])
}

model CircleMemberPermission {
  id           String   @id @default(cuid())
  membershipId String
  permission   String
  granted      Boolean
  grantedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership CircleMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permission])
  @@index([membershipId])
}

model Contribution {
  id                   String              @id @default(cuid())
  circleId             String
  userId               String
  planId               String?
  amount               Decimal             @db.Decimal(12, 2)
  status               ContributionStatus  @default(PAID)
  paymentDate          DateTime            @default(now())
  note                 String?
  createdById          String
  approvalRequestId    String?             @unique
  proofUrl             String?
  proofReference       String?
  paymentMethod        String?
  contributionMonth    String?
  verificationStatus   VerificationStatus  @default(PENDING)
  confidenceScore      Float?
  extractedAmount      Decimal?            @db.Decimal(12, 2)
  extractedDate        DateTime?
  extractedReference   String?
  extractedSender      String?
  verificationReason   String?
  verifiedById         String?
  verifiedAt           DateTime?
  rejectedById         String?
  rejectedAt           DateTime?
  rejectionReason      String?
  scheduleId           String?
  dueDate              DateTime?
  periodLabel          String?
  gracePeriodDays      Int                 @default(0)
  overdueAt            DateTime?
  lateFeeApplied       Boolean             @default(false)
  lateFeeAmount        Decimal?            @db.Decimal(12, 2)
  acknowledgedAt       DateTime?
  deletedAt            DateTime?
  statusBeforeDeletion ContributionStatus?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  circle          Circle                 @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user            User                   @relation("ContributionPayer", fields: [userId], references: [id])
  plan            ContributionPlan?      @relation(fields: [planId], references: [id])
  schedule        ContributionSchedule?  @relation(fields: [scheduleId], references: [id])
  createdBy       User                   @relation("ContributionRecorder", fields: [createdById], references: [id])
  approvalRequest ApprovalRequest?       @relation(fields: [approvalRequestId], references: [id])
  goalAllocations GoalAllocation[]
  reminders       ContributionReminder[]

  @@index([circleId])
  @@index([userId])
  @@index([planId])
  @@index([scheduleId])
  @@index([dueDate])
  @@index([status])
  @@index([createdAt])
}

enum ContributionFrequency {
  WEEKLY
  MONTHLY
  ONCE_OFF
  CUSTOM
}

enum ContributionStatus {
  PAID
  PENDING
  PENDING_REVIEW
  PROOF_SUBMITTED
  UPCOMING
  DUE
  CONFIRMED
  REJECTED
  OVERDUE
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  NEEDS_REVIEW
  REJECTED
}

enum ContributionScheduleFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
}

model ContributionSchedule {
  id              String                        @id @default(cuid())
  circleId        String
  name            String                        @default("Contribution Schedule")
  amount          Decimal                       @db.Decimal(12, 2)
  frequency       ContributionScheduleFrequency @default(MONTHLY)
  firstDueDate    DateTime
  dueDay          Int?
  gracePeriodDays Int                           @default(0)
  lateFee         Decimal?                      @db.Decimal(12, 2)
  autoGenerate    Boolean                       @default(true)
  isActive        Boolean                       @default(true)
  lastGeneratedAt DateTime?
  nextDueDate     DateTime?
  deletedAt       DateTime?
  createdById     String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  circle        Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("ContributionScheduleCreator", fields: [createdById], references: [id])
  contributions Contribution[]

  @@index([circleId])
  @@index([isActive])
}

model ContributionReminder {
  id             String   @id @default(cuid())
  contributionId String
  stage          String
  sentAt         DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([contributionId, stage])
  @@index([contributionId])
}

enum ApprovalType {
  CONTRIBUTION
  EXPENSE
  SETTLEMENT
  PROJECT
  WALLET_WITHDRAWAL
  WALLET_TRANSFER
  GOAL_WITHDRAWAL
  JOIN_REQUEST
  MEMBER_PROMOTION
  PAYOUT
  CONSTITUTION_AMENDMENT
  GOVERNANCE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

model ContributionPlan {
  id          String                @id @default(cuid())
  circleId    String
  name        String
  description String?
  amount      Decimal               @db.Decimal(12, 2)
  frequency   ContributionFrequency @default(MONTHLY)
  dueDay      Int?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean               @default(true)
  deletedAt   DateTime?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  circle        Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("ContributionPlanCreator", fields: [createdById], references: [id])
  contributions Contribution[]

  @@index([circleId])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Goal {
  id            String     @id @default(cuid())
  circleId      String
  name          String
  description   String?
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  deadline      DateTime?
  deletedAt     DateTime?
  status        GoalStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  circle      Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id])
  allocations GoalAllocation[]

  @@index([circleId])
}

model GoalAllocation {
  id             String    @id @default(cuid())
  circleId       String
  goalId         String
  userId         String
  contributionId String?
  amount         Decimal   @db.Decimal(12, 2)
  note           String?
  allocationDate DateTime  @default(now())
  deletedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  circle       Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  goal         Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user         User          @relation("GoalAllocationReceiver", fields: [userId], references: [id])
  contribution Contribution? @relation(fields: [contributionId], references: [id])
  createdBy    User          @relation("GoalAllocationCreator", fields: [createdById], references: [id])

  @@index([circleId])
  @@index([goalId])
  @@index([userId])
}

enum SplitType {
  EQUAL
  PERCENTAGE
  EXACT
}

model Expense {
  id          String    @id @default(cuid())
  circleId    String
  paidById    String
  createdById String
  title       String
  notes       String?
  amount      Decimal   @db.Decimal(12, 2)
  category    String    @default("other")
  splitType   SplitType @default(EQUAL)
  expenseDate DateTime  @default(now())
  receiptUrl  String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  circle    Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePayer", fields: [paidById], references: [id])
  createdBy User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  splits    ExpenseSplit[]

  @@index([circleId])
  @@index([createdAt])
}

model ExpenseSplit {
  id         String    @id @default(cuid())
  expenseId  String
  userId     String
  amount     Decimal   @db.Decimal(12, 2)
  percentage Decimal?  @db.Decimal(5, 2)
  settled    Boolean   @default(false)
  settledAt  DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Balance {
  id         String   @id @default(cuid())
  circleId   String
  debtorId   String
  creditorId String
  amount     Decimal  @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  debtor   User   @relation("Debtor", fields: [debtorId], references: [id])
  creditor User   @relation("Creditor", fields: [creditorId], references: [id])

  @@unique([circleId, debtorId, creditorId])
  @@index([circleId])
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model Settlement {
  id             String           @id @default(cuid())
  circleId       String
  debtorId       String
  creditorId     String
  amount         Decimal          @db.Decimal(12, 2)
  note           String?
  settlementDate DateTime         @default(now())
  status         SettlementStatus @default(PENDING)
  createdById    String
  confirmedById  String?
  confirmedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  circle      Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  debtor      User   @relation("SettlementDebtor", fields: [debtorId], references: [id])
  creditor    User   @relation("SettlementCreditor", fields: [creditorId], references: [id])
  createdBy   User   @relation("SettlementCreator", fields: [createdById], references: [id])
  confirmedBy User?  @relation("SettlementConfirmer", fields: [confirmedById], references: [id])

  @@index([circleId])
  @@index([debtorId])
  @@index([creditorId])
}

enum TransactionType {
  CONTRIBUTION
  EXPENSE
  SETTLEMENT
  WITHDRAWAL
  GOAL_ALLOCATION
}

model Transaction {
  id            String          @id @default(cuid())
  circleId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  referenceId   String?
  referenceType String?
  initiatedById String
  createdAt     DateTime        @default(now())

  circle      Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  initiatedBy User   @relation(fields: [initiatedById], references: [id])

  @@index([circleId])
  @@index([initiatedById])
}

enum NotificationType {
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  NEW_MEMBER_JOINED
  CONTRIBUTION_MADE
  CONTRIBUTION_PLAN_CREATED
  CONTRIBUTION_REMINDER
  EXPENSE_ADDED
  SETTLEMENT_REQUESTED
  SETTLEMENT_CONFIRMED
  SETTLEMENT_REJECTED
  GOAL_CREATED
  GOAL_ALLOCATION_ADDED
  GOAL_COMPLETED
  GOAL_DEADLINE_REMINDER
  RECEIPT_ISSUED
  RECEIPT_VOIDED
  RECEIPT_REPLACED
  STATEMENT_READY
  APPROVAL_STAGE_ACTIVATED
  APPROVAL_STAGE_COMPLETED
  APPROVAL_ASSIGNED
  APPROVAL_DELEGATED
  APPROVAL_ESCALATED
  APPROVAL_OVERDUE
  APPROVAL_WORKFLOW_COMPLETED
  PROJECT_CREATED
  FEED_POST_CREATED
