  version   Int
  content   Json
  changeNote String?
  publishedAt DateTime?
  editedById String
  createdAt DateTime @default(now())

  minutes  MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  editedBy User           @relation("MinutesVersionEditor", fields: [editedById], references: [id])

  @@unique([minutesId, version])
  @@index([minutesId])
}

model GovernanceVote {
  id            String               @id @default(cuid())
  circleId      String
  meetingId     String?
  createdById   String
  title         String
  description   String?
  motionCategory MotionCategory      @default(GENERAL_MOTION)
  type          GovernanceVoteType   @default(YES_NO)
  status        GovernanceVoteStatus @default(OPEN)
  quorumPercent Int?
  thresholdPercent Int?
  anonymous     Boolean              @default(false)
  majorFinancial Boolean             @default(false)
  closesAt      DateTime?
  finalizedAt   DateTime?
  result        Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  circle    Circle                @relation(fields: [circleId], references: [id], onDelete: Cascade)
  meeting   Meeting?              @relation(fields: [meetingId], references: [id])
  createdBy User                  @relation("VoteCreator", fields: [createdById], references: [id])
  options   GovernanceVoteOption[]
  ballots   GovernanceBallot[]
  records   GovernanceVoteRecord[]
  decision  GovernanceDecision?

  @@index([circleId, status])
  @@index([meetingId])
}

model GovernanceVoteOption {
  id         String   @id @default(cuid())
  voteId     String
  text       String
  sortOrder  Int      @default(0)
  createdById String
  createdAt  DateTime @default(now())

  vote      GovernanceVote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("VoteOptionCreator", fields: [createdById], references: [id])
  votes     GovernanceVoteRecord[]

  @@index([voteId])
}

/**
 * One member's filled-in ballot for a governance vote. A single ballot owns one or
 * more records (multi-choice selections / ranked preferences) and is unique per
 * member per vote, enforcing one-ballot-per-member. Revoting swaps the ballot's
 * records atomically.
 */
model GovernanceBallot {
  id        String   @id @default(cuid())
  voteId    String
  userId    String
  castAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  vote    GovernanceVote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user    User                 @relation("VoteBallot", fields: [userId], references: [id])
  records GovernanceVoteRecord[]

  @@unique([voteId, userId])
  @@index([voteId])
}

model GovernanceVoteRecord {
  id        String   @id @default(cuid())
  ballotId  String
  voteId    String
  optionId  String
  userId    String
  rank      Int?
  castAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  ballot GovernanceBallot      @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  vote   GovernanceVote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option GovernanceVoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User                 @relation("VoteCaster", fields: [userId], references: [id])

  @@unique([ballotId, optionId])
  @@unique([ballotId, rank])
  @@index([voteId])
  @@index([optionId])
}

/**
 * Immutable record created when a governance vote is finalized, linking the
 * motion and its formal decision to the vote result. There is no update path —
 * finalized decisions are permanent and audited via GOV_DECISION_RECORDED.
 */
model GovernanceDecision {
  id             String         @id @default(cuid())
  circleId       String
  voteId         String         @unique
  createdById    String
  title          String
  motionCategory MotionCategory @default(GENERAL_MOTION)
  outcome        String
  result         Json
  effectiveAt    DateTime?
  createdAt      DateTime       @default(now())

  circle    Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  vote      GovernanceVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  createdBy User           @relation("DecisionCreator", fields: [createdById], references: [id])

  @@index([circleId])
}

/**
 * Tracks each member's acknowledgement of published meeting minutes within a
 * circle. Members are eligible once the minutes are PUBLISHED; duplication is
 * prevented by the unique (minutesId, userId) pair.
 */
model MeetingMinutesAcknowledgement {
  id        String   @id @default(cuid())
  minutesId String
  userId    String
  acknowledgedAt DateTime @default(now())

  minutes MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  user    User           @relation("MinutesAcknowledgeUser", fields: [userId], references: [id])

  @@unique([minutesId, userId])
  @@index([minutesId])
}
