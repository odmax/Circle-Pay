model ProjectInvestorAgreement {
  id                   String                 @id @default(cuid())
  projectId            String
  participantId        String
  agreementType        ProjectAgreementType   @default(EQUITY)
  principal            Decimal                @db.Decimal(12, 2)
  ownershipPercentage  Decimal?               @db.Decimal(6, 2)
  profitPercentage     Decimal?               @db.Decimal(6, 2)
  revenuePercentage    Decimal?               @db.Decimal(6, 2)
  interestRate         Decimal?               @db.Decimal(5, 4)
