model ProjectOwnershipEntry {
  id                    String   @id @default(cuid())
  snapshotId            String
  projectId             String
  participantId         String
  capitalContributed    Decimal  @db.Decimal(12, 2)
  ownershipPercentage   Decimal  @db.Decimal(6, 2)
  profitSharePercentage Decimal  @db.Decimal(6, 2)
  votingPercentage      Decimal  @db.Decimal(6, 2)
  sourceTransactions    String? // JSON array of capital transaction IDs
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  snapshot    ProjectOwnershipSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participant ProjectParticipant       @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, participantId])
  @@index([snapshotId])
  @@index([projectId])
  @@index([participantId])
}


// ?"?" Constitution / Rules Engine ?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"

// One constitution per circle; points at the currently active/published version.
model Constitution {
  id             String   @id @default(cuid())
  circleId       String   @unique
  title          String   @default("Constitution")
  preamble       String?
  activeVersionId String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  circle         Circle                  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation("ConstitutionCreator", fields: [createdById], references: [id])
  versions       ConstitutionVersion[]
  ruleSettings   ConstitutionRuleSetting[]
}

enum ConstitutionStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  SUPERSEDED
}

model ConstitutionVersion {
  id            String             @id @default(cuid())
  constitutionId String
  version       Int
  status        ConstitutionStatus @default(DRAFT)
  content       Json
  effectiveDate DateTime?
  activatedAt   DateTime?
  publishedAt   DateTime?
  supersededAt  DateTime?
  supersededById String?
  createdById   String
  createdAt     DateTime           @default(now())

  constitution  Constitution       @relation(fields: [constitutionId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("ConstitutionVersionCreator", fields: [createdById], references: [id])
  acceptances   ConstitutionAcceptance[]
  amendments    ConstitutionAmendment[]
  rules         ConstitutionRuleSetting[]

  @@unique([constitutionId, version])
  @@index([constitutionId, status])
}

model ConstitutionAcceptance {
  id          String   @id @default(cuid())
  versionId   String
  userId      String
  acceptedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  version ConstitutionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([versionId, userId])
  @@index([versionId])
  @@index([userId])
}

enum ConstitutionAmendmentStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
}

model ConstitutionAmendment {
  id          String                       @id @default(cuid())
  versionId   String
  circleId    String
  clauseKey   String
  clauseTitle String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  proposerId  String
  status      ConstitutionAmendmentStatus  @default(PROPOSED)
  approvalId  String?
  effectiveDate DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  version  ConstitutionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  circle   Circle              @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proposer User                @relation(fields: [proposerId], references: [id])

  @@index([versionId])
  @@index([circleId])
}

enum ConstitutionConflictStatus {
  OPEN
  PENDING_REVIEW
  RESOLVED
  DISMISSED
}

enum ConstitutionSource {
  CONSTITUTION
  CIRCLE_SETTINGS
  PREFERRED
}

// A detected conflict between a constitution rule and an existing circle setting.
model ConstitutionRuleConflict {
  id           String                   @id @default(cuid())
  circleId     String
  ruleKey      String
  ruleSource   String
  constitutionValue Json?
  settingKey   String
  settingValue Json?
  resolution   Json?
  status       ConstitutionConflictStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  resolvedAction String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  circle      Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  resolvedBy  User?  @relation("ConflictResolver", fields: [resolvedById], references: [id])

  @@index([circleId, status])
}

enum RuleValueType {
  NUMBER
  BOOLEAN
  STRING
  ENUM
  JSON
}

// Executable rule settings derived from the active constitution for enforcement.
model ConstitutionRuleSetting {
  id            String        @id @default(cuid())
  constitutionId String
  versionId     String
  key           String
  ruleType      String
  valueType     RuleValueType @default(JSON)
  value         Json
  sourceClause  String?
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  constitution Constitution       @relation(fields: [constitutionId], references: [id], onDelete: Cascade)
  version      ConstitutionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([constitutionId, key])
  @@unique([versionId, key])
  @@index([constitutionId])
}

// ─── Meetings, Voting & Governance ─────────────────────────

enum MeetingType {
  GENERAL
  MONTHLY
  ANNUAL
  EMERGENCY
  SPECIAL
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MeetingRSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum AgendaItemStatus {
  OPEN
  DISCUSSED
  DECIDED
  DEFERRED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MeetingMinutesStatus {
  DRAFT
  REVIEW
  PUBLISHED
  AMENDED
}

enum MotionCategory {
  CONSTITUTION_AMENDMENT
  NEW_MEMBER
  FINANCIAL
  PAYOUT_EXCEPTION
  PROJECT
  GENERAL_MOTION
